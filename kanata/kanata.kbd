(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defsrc
  caps d f h j k l u i n m p spc
)

(deflayer base
  (tap-hold 200 200 esc (layer-while-held nav))
  d    f    h    j    k    l    u    i    n    m    p    spc
)

(deflayer nav
  _
  lctl lsft left down up rght XX   XX   XX   XX   caps bspc
)

(defchordsv2
  (h j) home 75 first-release (base)
  (k l) end 75 first-release (base)
  (u i) pgup 75 first-release (base)
  (n m) pgdn 75 first-release (base)
)
