#!/usr/bin/python3

from pathlib import Path
import time
import sys
import os
import argparse
import json
import pynvim
color_file = '/home/kristijan/.cache/main_colorscheme.conf'
hyprland_color_file = '/home/kristijan/.cache/hyprland_colorscheme.lua'
noctalia_palette_file = '/home/kristijan/neovim-config/noctalia/palettes/Neovim.json'

parser = argparse.ArgumentParser()
parser.add_argument('bg', nargs='?', default=None,
                    choices=['dark', 'light', 'toggle'])

args = parser.parse_args()
bg = args.bg
current_bg = os.getenv('NVIM_COLORSCHEME_BG')

if Path(color_file).exists():
    cfile = open(color_file, 'r')
    first_line = cfile.readline().rstrip()
    current_bg = first_line.split('=')[1]
elif not bg:
    print('You must provide background type argument on first run', file=sys.stderr)
    exit()

if not bg:
    exit()

if bg == 'toggle':
    bg = 'dark' if current_bg == 'light' else 'light'


os.environ['NVIM_COLORSCHEME_BG'] = bg
nvim = pynvim.attach(
    'child', argv=["/usr/bin/env", "nvim", "--embed", "--headless"])


def get_hl_color(name):
    hl = nvim.api.get_hl(0, {'name': name, 'link': False})

    def hex(key):
        return '#%06x' % hl[key] if key in hl else ''
    return hex('fg'), hex('bg')


normal_fg, normal_bg = get_hl_color('Normal')
cursor_fg, cursor_bg = get_hl_color('Cursor')
selection_fg, selection_bg = get_hl_color('Visual')

active_tab_bg = nvim.eval('g:terminal_color_4')
inactive_tab_bg = nvim.eval('g:terminal_color_' + (bg == 'dark' and '0' or '7'))
locked_tab_bg = nvim.eval('g:terminal_color_1')

command = [
    'env NVIM_COLORSCHEME_BG=' + bg,
    'foreground ' + normal_fg,
    'background ' + normal_bg,
    'cursor ' + (cursor_bg.startswith('#') and cursor_bg or normal_fg),
    'cursor_text_color background',
    'active_tab_foreground ' + normal_bg,
    'active_tab_background ' + active_tab_bg,
    'inactive_tab_foreground ' + normal_fg,
    'inactive_tab_background ' + inactive_tab_bg,
    'selection_foreground ' +
    (selection_fg.startswith('#') and selection_fg or 'none'),
    'selection_background ' +
    (selection_bg.startswith('#') and selection_bg or normal_fg)
]
for i in range(0, 16):
    command.append('color' + str(i) + ' ' +
                   nvim.eval('g:terminal_color_' + str(i)))



def noctalia_variant(variant):
    nvim.command('set background=' + variant)
    p = nvim.exec_lua('return require("partials.plugins.colorscheme").default_palette()')
    tone, on = ('Dark', 'Light') if variant == 'light' else ('Light', 'Dark')
    fg, bg = get_hl_color('Normal')
    sel_fg, sel_bg = get_hl_color('Visual')
    term = [nvim.eval('g:terminal_color_' + str(i)) for i in range(16)]
    names = ['black', 'red', 'green', 'yellow', 'blue', 'magenta', 'cyan', 'white']
    on_accent = p[on + 'Grey1']
    return {
        'mPrimary': p[tone + 'Blue'],
        'mOnPrimary': on_accent,
        'mSecondary': p[tone + 'Cyan'],
        'mOnSecondary': on_accent,
        'mTertiary': p[tone + 'Green'],
        'mOnTertiary': on_accent,
        'mError': p[tone + 'Red'],
        'mOnError': on_accent,
        'mSurface': bg,
        'mOnSurface': fg,
        'mHover': p[tone + 'Cyan'],
        'mOnHover': on_accent,
        'mSurfaceVariant': p[on + 'Grey3'],
        'mOnSurfaceVariant': p[tone + 'Grey3'],
        'mOutline': p[on + 'Grey4'],
        'mShadow': p['DarkGrey1'] if variant == 'dark' else p['LightGrey4'],
        'terminal': {
            'background': bg,
            'foreground': fg,
            'cursor': fg,
            'cursorText': bg,
            'selectionBg': sel_bg.startswith('#') and sel_bg or fg,
            'selectionFg': sel_fg.startswith('#') and sel_fg or fg,
            'normal': dict(zip(names, term[:8])),
            'bright': dict(zip(names, term[8:])),
        },
    }


if nvim.eval('g:colors_name') == 'default':
    palette = {v: noctalia_variant(v) for v in ['dark', 'light']}
    os.makedirs(os.path.dirname(noctalia_palette_file), exist_ok=True)
    with open(noctalia_palette_file, 'w') as f:
        json.dump(palette, f, indent=4)
        f.write('\n')

nvim.close()

file = open(color_file, 'w')
file.write('\n'.join(command))
file.close()


def rgb(color):
    return "'rgb(" + color.lstrip('#') + ")'"


file = open(hyprland_color_file, 'w')
file.write(f'''hl.config({{
  group = {{
    col = {{
      border_inactive = {rgb(inactive_tab_bg)},
      border_locked_active = {rgb(locked_tab_bg)},
      border_locked_inactive = {rgb(inactive_tab_bg)},
    }},
    groupbar = {{
      col = {{
        active = {rgb(active_tab_bg)},
        inactive = {rgb(inactive_tab_bg)},
        locked_active = {rgb(locked_tab_bg)},
        locked_inactive = {rgb(inactive_tab_bg)},
      }},
      text_color = {rgb(normal_bg)},
      text_color_inactive = {rgb(normal_fg)},
      text_color_locked_active = {rgb(normal_bg)},
      text_color_locked_inactive = {rgb(normal_fg)},
    }},
  }},
}})
''')
file.close()

os.system('noctalia msg theme-mode-set ' + bg)
os.system('gsettings set org.gnome.desktop.interface color-scheme prefer-' + bg)
os.system('~/neovim-config/scripts/reload_kitty_colors.sh')
os.system(f"hyprctl eval \"dofile('{hyprland_color_file}')\" >/dev/null 2>&1")
